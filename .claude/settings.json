{
  "permissions": {
    "defaultMode": "default",
    "additionalDirectories": [
      "Z:/AI-DESK"
    ],
    "allow": [
      "Write(**)",
      "Edit(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Write(Z:/**)",
      "Edit(Z:/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "PowerShell(Remove-Item:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}

