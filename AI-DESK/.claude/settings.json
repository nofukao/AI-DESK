{
  "permissions": {
    "allow": [
      "Edit(*/out/**)"
    ],
    "deny": [
      "Edit(/out/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/GEMINI.md)",
      "Edit(/README.md)",
      "Edit(/PROFILE.example.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.ai-desk/**)",
      "Edit(/bin/**)",
      "Edit(/task_template/**)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(mv:*)",
      "Bash(del:*)",
      "Bash(git:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(Move-Item:*)",
      "PowerShell(Clear-Content:*)",
      "PowerShell(git:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}\\.claude\\hooks\\guard-write.ps1"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}\\bin\\setup_history.ps1",
              "-Path",
              "${CLAUDE_PROJECT_DIR}",
              "-Quiet"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "autoMemoryEnabled": false
}
